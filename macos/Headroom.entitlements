<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime entitlements for Developer ID + notarization.
	     No App Sandbox: the menu bar talks to localhost host, LAN ESP32,
	     and launches the bundled Python host via /usr/bin/python3. -->

	<!-- The one thing shared with the widget extension, which is sandboxed and
	     can reach nothing else. An app outside the sandbox still needs the team
	     id in front of the group name, and $(TeamIdentifierPrefix) is what
	     supplies it — hardcoding a team would stop forks from signing as
	     themselves. scripts/build-app.sh substitutes it for manual signing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.centaur-labs.headroom</string>
	</array>

	<!-- Hardened Runtime blocks Calendar access unless the app declares it.
	     Not a restricted entitlement: no profile needed. The reset calendar
	     writes through EventKit (macos/Sources/ResetCalendarSync.swift). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>

	<!-- Multi-Mac CloudKit entitlements are deliberately NOT here. They are
	     `com.apple.developer.*`, which is the restricted family: a signature
	     carrying one without a provisioning profile that authorizes it is
	     rejected at launch. This app is signed by scripts/build-app.sh with a
	     bare Developer ID identity and no embedded profile, so adding them
	     here would break every shipped build to enable a feature that still
	     would not work.

	     They live in Headroom-iCloud.entitlements and are merged in only when
	     HEADROOM_PROVISION_PROFILE supplies a profile. See docs/multi-mac.md. -->
</dict>
</plist>
