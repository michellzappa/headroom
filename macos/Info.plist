<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle (docs/updater.md). Xcode merges these keys into the generated
	     Info.plist. The public key is SPARKLE_PUBLIC_ED_KEY in project.yml. -->
	<key>SUFeedURL</key>
	<string>https://github.com/michellzappa/headroom/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
